{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "es2023",
    "outDir": "dist",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "lib": ["es2023"],
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
