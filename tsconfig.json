{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "esnext",
    "outDir": "dist",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["esnext", "dom"],
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
